<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.Desktop.Roster"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Attendly.Desktop.Roster.SantriEditView"
             x:DataType="vm:SantriEditViewModel">
  <!-- Make the entire content scrollable -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10" Margin="0,0,8,0"> <!-- small right margin for scrollbar clearance -->
      <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="Bold"/>

      <TextBlock Text="NIK" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Nik}"/>

      <TextBlock Text="Nama Lengkap" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Nama}"/>

      <TextBlock Text="Nama Panggilan" FontWeight="SemiBold"/>
      <TextBox Text="{Binding NamaPanggilan}"/>

      <TextBlock Text="Jenis Kelamin" FontWeight="SemiBold"/>
      <ComboBox ItemsSource="{Binding GenderChoices}" SelectedItem="{Binding SelectedGender}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GenderOption">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="Tartil" FontWeight="SemiBold"/>
      <ComboBox ItemsSource="{Binding TartilChoices}" SelectedItem="{Binding SelectedTartil}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TartilFilterOption">
            <TextBlock Text="{Binding Label}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="Tempat Lahir (opsional)" FontWeight="SemiBold"/>
      <TextBox Text="{Binding TempatLahir}"/>

      <TextBlock Text="Alamat (opsional)" FontWeight="SemiBold"/>
      <TextBox Text="{Binding Alamat}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>

      <TextBlock Text="Tahun Masuk TPQ" FontWeight="SemiBold"/>
      <NumericUpDown Value="{Binding MasukTpqTahun}" Minimum="2000" Maximum="2100"/>

      <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
        <Button Content="Simpan" Command="{Binding SaveCommand}" Classes="primary"/>
        <Button Content="Batal" Command="{Binding CancelCommand}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
