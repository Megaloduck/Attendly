<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.Desktop.Roster"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Attendly.Desktop.Roster.RosterView"
             x:DataType="vm:RosterViewModel">
  <Grid ColumnDefinitions="*,340" Margin="16">
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,16,0">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <ComboBox Grid.Column="0" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TartilFilterOption">
              <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="+ Tambah Santri" Command="{Binding AddNewCommand}" Margin="8,0,0,0"/>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SantriRowViewModel">
              <Border Padding="10" Margin="0,0,0,6" CornerRadius="6" Background="#F3F4F6">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Nama}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SubtitleDisplay}" Opacity="0.7" FontSize="12"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Edit" Command="{Binding EditCommand}" Margin="0,0,6,0"/>
                  <Button Grid.Column="2" Content="Nonaktifkan" Command="{Binding DeactivateCommand}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="8" Padding="16"
            IsVisible="{Binding Editing, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding Editing}"/>
    </Border>
  </Grid>
</UserControl>