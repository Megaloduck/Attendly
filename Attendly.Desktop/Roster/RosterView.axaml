<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.Desktop.Roster"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Desktop.Roster.RosterView"
             x:DataType="vm:RosterViewModel">

    <Border Background="{DynamicResource AppBackgroundBrush}">
        <Grid ColumnDefinitions="*,350">
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="24,24,0,24">
            <!-- Header Section - Row 0 -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="Data Santri" Classes="heading"/>
                <TextBlock Text="Kelola informasi status dan Identitas santri." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
                <!-- Main Content - Left Panel - Row 1 -->
            <Grid Grid.Row="1"> 
                <Grid RowDefinitions="Auto,*" Margin="0,0,16,0">
                    <!-- Toolbar: Tartil filter, name search, add button -->
                    <Grid Grid.Row="0" ColumnDefinitions="180,*,Auto" Margin="0,0,0,12">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding FilterOptions}"
                                  SelectedItem="{Binding SelectedFilter}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TartilFilterOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="Cari nama santri..." VerticalAlignment="Stretch"  Margin="0,0,8,0">
                            <TextBox.InnerLeftContent>
                                <controls:LucideIcon Kind="Search" Width="16" Height="16" Margin="8,0,0,0" Opacity="0.5"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <Button Grid.Column="2"
                                Content="+ Tambah Santri"
                                Command="{Binding AddNewCommand}"
                                Classes="primary"/>
                    </Grid>
                     <!-- Santri List -->
                    <Grid Grid.Row="1">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SantriRowViewModel">
                                        <Border Padding="10"
                                                Margin="0,0,0,6"
                                                CornerRadius="6"
                                                Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nama}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SubtitleDisplay}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="12"/>
                                                </StackPanel>

                                                <!-- Icon-only actions: view overview, edit, deactivate -
                                                     same compact pattern as DesktopPairingView's device rows. -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <Button Command="{Binding InspectCommand}" Background="Transparent" Padding="6">
                                                        <controls:LucideIcon Kind="Eye" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Command="{Binding EditCommand}" Background="Transparent" Padding="6">
                                                        <controls:LucideIcon Kind="Pencil" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Command="{Binding DeactivateCommand}" Background="Transparent" Padding="6">
                                                        <controls:LucideIcon Kind="Trash2" Width="16" Height="16" Stroke="{DynamicResource StatusErrorBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel IsVisible="{Binding IsSearchEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <controls:LucideIcon Kind="Search" Width="28" Height="28" Opacity="0.4" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tidak ada santri yang cocok" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
                  <!-- Footer/Status Bar - Row 2 -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        Spacing="8" 
                        Margin="0,16,0,0">
                <TextBlock Text="Total Santri: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding TotalCount}" FontWeight="SemiBold"/>
            </StackPanel>
                </Grid>

                <!-- Right Panel: Edit form or read-only status overview - mutually
                     exclusive, both bound in the same cell so only one ever shows. -->
                <Grid Grid.Column="1">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="16"
                            IsVisible="{Binding Editing, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding Editing}"/>
                    </Border>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            Padding="16"
                            IsVisible="{Binding Inspecting, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                        <ContentControl Content="{Binding Inspecting}"/>
                    </Border>
                </Grid>
        </Grid>
    </Border>
</UserControl>
