<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.Desktop.Dashboard"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Desktop.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">
      <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
        <TextBlock Text="Dashboard" Classes="heading"/>
        <TextBlock Text="Ringkasan absensi santri   ." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal">
        <!-- Statistics ring: santri already assigned to a Kelas, at a glance -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,16,0">
          <StackPanel Spacing="10" HorizontalAlignment="Stretch">
            <TextBlock Text="Statistik" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Left"/>
            <Grid Width="160" Height="160">
              <controls:DonutProgress Percentage="{Binding AssignedPercentage}"
                                       ProgressBrush="{DynamicResource AccentBrush}"
                                       TrackBrush="{DynamicResource BorderSubtleBrush}"
                                       StrokeThickness="16"/>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding AssignedPercentageDisplay}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Sudah di Kelas" FontSize="12" Opacity="0.7" HorizontalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding TotalSantri, StringFormat='{}{0} Total Santri'}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Stat cards: icon badge + number + label -->
  <ItemsControl Grid.Column="1" ItemsSource="{Binding StatCards}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Columns="3" HorizontalAlignment=""/>
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:DashboardStatCard">
        <Border Background="{DynamicResource SurfaceBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="16" 
                Margin="0,0,12,12">
          <StackPanel Spacing="10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              
              <!-- Value Text -->
              <TextBlock Grid.Column="0" 
                         Text="{Binding Value}" 
                         FontSize="24" 
                         FontWeight="Bold"
                         VerticalAlignment="Center"
                         Foreground="{Binding AccentBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
              
              <!-- Icon Badge -->
              <Border Grid.Column="1" 
                      Width="40" 
                      Height="40" 
                      CornerRadius="10" 
                      Background="{Binding BadgeBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}">
                <controls:LucideIcon Kind="{Binding Icon}" 
                                     Width="20" 
                                     Height="20"
                                     Stroke="{Binding AccentBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Center"/>
              </Border>
            </Grid>
            
            <!-- Label -->
            <TextBlock Text="{Binding Label}" 
                       Foreground="{DynamicResource TextSecondaryBrush}" 
                       FontSize="13"/>
          </StackPanel>
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
      </StackPanel>

      <!-- Santri per Kelas: label + proportional bar + count -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel Spacing="14">
          <TextBlock Text="Santri per Kelas" FontSize="16" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding PerTartil}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TartilCountViewModel">
                <Grid ColumnDefinitions="140,*,40" Margin="0,0,0,10" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                  <ProgressBar Grid.Column="1" Value="{Binding PercentOfTotal}" Maximum="100"
                               Height="8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
    