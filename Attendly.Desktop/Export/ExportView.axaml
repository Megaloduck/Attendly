<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.Desktop.Export"
             x:Class="Attendly.Desktop.Export.ExportView"
             x:DataType="vm:ExportViewModel">
  <StackPanel Margin="24" Spacing="12" MaxWidth="420">
    <TextBlock Text="Ekspor Absensi" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="Pilih kelas dan bulan, lalu ekspor sesuai format buku absensi asli." Opacity="0.7" TextWrapping="Wrap"/>

    <TextBlock Text="Kelas" FontWeight="SemiBold"/>
    <ComboBox ItemsSource="{Binding AvailableTartil}" SelectedItem="{Binding SelectedTartil}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TartilOption">
          <TextBlock Text="{Binding Label}"/>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <Grid ColumnDefinitions="*,*">
      <StackPanel Grid.Column="0" Margin="0,0,6,0">
        <TextBlock Text="Bulan" FontWeight="SemiBold"/>
        <NumericUpDown Value="{Binding SelectedMonth}" Minimum="1" Maximum="12"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="6,0,0,0">
        <TextBlock Text="Tahun" FontWeight="SemiBold"/>
        <NumericUpDown Value="{Binding SelectedYear}" Minimum="2020" Maximum="2100"/>
      </StackPanel>
    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Content="Ekspor CSV" Click="OnExportCsvClick"/>
      <Button Content="Ekspor Excel" Click="OnExportXlsxClick"/>
    </StackPanel>

    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.85"/>
  </StackPanel>
</UserControl>  