<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Attendly.Desktop"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Desktop.DesktopShellView"
             x:DataType="local:DesktopShellViewModel">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="0,16,0,16">
        <TextBlock Grid.Row="0" Text="Attendly" Foreground="{StaticResource SidebarTextBrush}" FontSize="20" FontWeight="Bold" Margin="20,0,0,24"/>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:NavItemViewModel">
              <Button Command="{Binding SelectCommand}"
                      Classes="nav-item"
                      Classes.active="{Binding IsActive}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <controls:LucideIcon Kind="{Binding Icon}" Width="18" Height="18" Stroke="{StaticResource SidebarTextBrush}"/>
                  <TextBlock Text="{Binding Label}" Foreground="{StaticResource SidebarTextBrush}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="2" Command="{Binding ToggleThemeCommand}"
                Classes="nav-item"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <controls:LucideIcon Kind="{Binding ThemeMode, Converter={StaticResource ThemeModeToIconKindConverter}}" Width="18" Height="18" Stroke="{StaticResource SidebarTextBrush}"/>
            <TextBlock Text="{Binding ThemeMode, Converter={StaticResource ThemeModeToLabelConverter}}" Foreground="{StaticResource SidebarTextBrush}"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
  </Grid>
</UserControl>