<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.Desktop.MonthlyGrid"
             xmlns:exp="using:Attendly.Desktop.Export"
             x:Class="Attendly.Desktop.MonthlyGrid.MonthlyGridView"
             x:DataType="vm:MonthlyGridViewModel">
  <Border Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
      <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
        <TextBlock Text="Absensi Bulanan" Classes="heading"/>
        <TextBlock Text="Rekap kehadiran satu kelas dalam satu bulan." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Filter bar: Tartil / bulan / tahun, plus the color key -->
      <Border Grid.Row="1" Classes="filter-bar" Margin="0,0,0,16">
        <Grid ColumnDefinitions="200,120,150,*">
          <ComboBox Grid.Column="0" Classes="filter" ItemsSource="{Binding AvailableTartil}" SelectedItem="{Binding SelectedTartil}" Margin="0,0,8,0" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="exp:TartilOption">
                <TextBlock Text="{Binding Label}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <NumericUpDown Grid.Column="1" Value="{Binding SelectedMonth}" Minimum="1" Maximum="12" Margin="0,0,8,0"/>
          <NumericUpDown Grid.Column="2" Value="{Binding SelectedYear}" Minimum="2020" Maximum="2100"/>

          <ItemsControl Grid.Column="3" ItemsSource="{Binding LegendItems}" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="14"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LegendItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Ellipse Classes="status-dot" Fill="{Binding ColorBrushKey, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                  <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>

      <!-- Flat data table - built in code-behind since its column count depends on
           the days-in-month and no DataGrid package is referenced. -->
      <Border Grid.Row="2" Classes="flat-card" Padding="0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="TableGrid"/>
        </ScrollViewer>
      </Border>

      <TextBlock Grid.Row="2" Text="Memuat..." IsVisible="{Binding IsLoading}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <!-- Four KPI summary cards - Izin and Sakit split apart so each gets its own
           number and its own status color, matching the legend and the grid dots. -->
      <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*" Margin="0,16,0,0">
        <Border Grid.Column="0" Classes="kpi-card" Margin="0,0,8,0">
          <StackPanel Spacing="6">
            <TextBlock Text="HADIR" Classes="kpi-label"/>
            <TextBlock Text="{Binding PresentCount}" Classes="kpi-value" Foreground="{DynamicResource StatusSuccessBrush}"/>
            <TextBlock Text="{Binding PresentPercent, StringFormat='{}{0:0}% dari sesi tercatat'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="kpi-card" Margin="8,0">
          <StackPanel Spacing="6">
            <TextBlock Text="ALPHA" Classes="kpi-label"/>
            <TextBlock Text="{Binding AbsentCount}" Classes="kpi-value" Foreground="{DynamicResource StatusErrorBrush}"/>
            <TextBlock Text="Tanpa keterangan" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="kpi-card" Margin="8,0">
          <StackPanel Spacing="6">
            <TextBlock Text="IZIN" Classes="kpi-label"/>
            <TextBlock Text="{Binding IzinCount}" Classes="kpi-value" Foreground="{DynamicResource StatusWarningBrush}"/>
            <TextBlock Text="Izin resmi" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Classes="kpi-card" Margin="8,0,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="SAKIT" Classes="kpi-label"/>
            <TextBlock Text="{Binding SakitCount}" Classes="kpi-value" Foreground="{DynamicResource StatusInfoBrush}"/>
            <TextBlock Text="Sakit" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</UserControl>
