      <Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Attendly.Controls">

  <!-- 44dp minimum tap target, applied app-wide so no button anywhere falls short. -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="MinWidth" Value="44"/>
  </Style>

  <!-- Default look for every LucideIcon: Lucide's actual stroke style (round caps/joins,
       2px stroke, no fill), scaled uniformly, 24x24 unless a usage overrides it. -->
  <Style Selector="controls|LucideIcon">
    <Setter Property="StrokeThickness" Value="2"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="Black"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
  </Style>

</Styles>