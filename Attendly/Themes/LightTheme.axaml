<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== Attendly UI Identity v1 - shared tokens ====================
       One token set for both Attendly (mobile) and Attendly.Desktop (admin) - see
       Attendly_UI_Identity_Statement_v1.md for the full rationale and the retirement
       table (§9) explaining what this replaces. No platform-specific keys below. -->

  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F3EC"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#EFE9DF"/>
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E4DDD0"/>

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A2724"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7A7367"/>

  <SolidColorBrush x:Key="AccentBrush" Color="#BD5B3D"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#F1DED4"/>

  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6E8F73"/>
  <SolidColorBrush x:Key="StatusWarningBrush" Color="#C08A4E"/>
  <SolidColorBrush x:Key="StatusErrorBrush" Color="#B2564A"/>
  <SolidColorBrush x:Key="StatusInfoBrush" Color="#7C8FA6"/>
  <SolidColorBrush x:Key="StatusNeutralBrush" Color="#A29C90"/>

  <!-- MonthlyGridView's programmatic table (Desktop) reads these two by exact name via
       GetBrush() in code-behind - keep the key names. Derived from the tokens above
       (SurfaceMuted for the header row, AppBackground for the zebra stripe) rather than
       independently hand-picked, per the Identity Statement's retirement table. -->
  <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#EFE9DF"/>
  <SolidColorBrush x:Key="GridStripeBackgroundBrush" Color="#F7F3EC"/>

  <!-- ==================== Transitional aliases ====================
       Old keys still referenced by views not yet migrated (Roster, ActivityLog,
       MobilePairing, MainView, DashboardView, DesktopPairingView, MonthlyGridView.axaml's
       outer Border - see Identity Statement §10 step 9). Point them at the new tokens so
       nothing breaks mid-migration; delete once every view references the canonical
       names directly. -->
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="FlatCardBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7F3EC"/>

</ResourceDictionary>
