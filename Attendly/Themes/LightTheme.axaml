<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F3F4F6"/>

  <!-- Flat enterprise dashboard palette (Desktop admin only) - deliberately separate
       from CardBackgroundBrush above so this restyle never touches mobile. -->
  <SolidColorBrush x:Key="PageBackgroundBrush" Color="#EEF1F5"/>
  <SolidColorBrush x:Key="FlatCardBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E5EA"/>

  <!-- MonthlyGridView's programmatic table - previously hardcoded static brushes in
       code-behind (didn't re-theme). Header/stripe get their own keys since nothing
       existing matches those exact tints; the cell border reuses BorderSubtleBrush
       so the grid's hairlines match every other flat-card border in the app. -->
  <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#F7F8FA"/>
  <SolidColorBrush x:Key="GridStripeBackgroundBrush" Color="#FAFBFC"/>


    
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="SidebarHoverBrush" Color="#334155"/>
            <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2563EB"/>
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#F1F5F9"/>
            <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#94A3B8"/>

</ResourceDictionary>       