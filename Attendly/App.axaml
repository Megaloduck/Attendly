<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Attendly"
             xmlns:conv="using:Attendly.Converters"
             x:Class="Attendly.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="avares://Attendly/Themes/LightTheme.axaml"/>
                <ResourceInclude x:Key="Dark" Source="avares://Attendly/Themes/DarkTheme.axaml"/>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Display/Heading serif, per Identity Statement §5. Not theme-dependent -
                 same face in Light and Dark, so it lives outside ThemeDictionaries
                 alongside the converters below. -->
            <FontFamily x:Key="HeadingFontFamily">avares://Attendly/Assets/Fonts/Lora.ttf#Lora</FontFamily>

            <conv:StatusChipBrushConverter x:Key="StatusChipBrushConverter"/>
            <conv:SyncStateToBrushConverter x:Key="SyncStateToBrushConverter"/>
            <conv:SyncStateToIconKindConverter x:Key="SyncStateToIconKindConverter"/>
            <conv:ThemeModeToIconKindConverter x:Key="ThemeModeToIconKindConverter"/>
            <conv:ThemeModeToLabelConverter x:Key="ThemeModeToLabelConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <conv:ResourceKeyToBrushConverter x:Key="ResourceKeyToBrushConverter"/>
            <conv:ActiveToDockBrushConverter x:Key="ActiveToDockBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Attendly/Styles/Styles.axaml"/>
    </Application.Styles>
</Application>
