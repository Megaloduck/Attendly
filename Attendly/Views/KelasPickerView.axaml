<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.ViewModels"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Views.KelasPickerView"
             x:DataType="vm:KelasPickerViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,16,16,8">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Pilih Kelas" FontSize="22" FontWeight="Bold"/>
        <TextBlock Text="{Binding TodayDisplay}" Opacity="0.6" FontSize="13"/>
      </StackPanel>
      <Button Grid.Column="1" Command="{Binding RefreshCommand}" Background="Transparent" Padding="6" VerticalAlignment="Center">
        <controls:LucideIcon Kind="RefreshCw" Width="18" Height="18"/>
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Kelas}" Margin="16,0,16,16">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:KelasSummaryViewModel">
              <Button Command="{Binding SelectCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Background="{DynamicResource CardBackgroundBrush}"
                      Padding="14"
                      Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#2563EB"
                          VerticalAlignment="Center" Margin="0,0,12,0">
                    <controls:LucideIcon Kind="Users" Width="20" Height="20" Stroke="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="{Binding SantriCount, StringFormat='{}{0} santri'}" Opacity="0.6" FontSize="12"/>
                    <ProgressBar Value="{Binding MarkedCountValue}" Maximum="{Binding SantriCountValue}" Height="5"
                                 IsVisible="{Binding IsSessionToday}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ProgressLabel}" FontSize="11" Foreground="#16A34A" IsVisible="{Binding IsComplete}"/>
                    <TextBlock Text="{Binding ProgressLabel}" FontSize="11" Foreground="#D97706" IsVisible="{Binding IsInProgress}"/>
                    <TextBlock Text="{Binding ProgressLabel}" FontSize="11" Foreground="#9CA3AF" IsVisible="{Binding !IsSessionToday}"/>
                  </StackPanel>

                  <controls:LucideIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="Memuat..." IsVisible="{Binding IsLoading}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
    </Grid>
  </Grid>
</UserControl>