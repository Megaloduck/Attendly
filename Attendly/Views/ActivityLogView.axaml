<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.ViewModels"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Views.ActivityLogView"
             x:DataType="vm:ActivityLogViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="12,12,12,8">
      <Button Grid.Column="0" Command="{Binding GoBackCommand}" Background="Transparent" Padding="6">
        <controls:LucideIcon Kind="ChevronLeft" Width="20" Height="20"/>
      </Button>
      <TextBlock Grid.Column="1" Text="Riwayat Perubahan" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
      <Button Grid.Column="2" Command="{Binding RefreshCommand}" Background="Transparent" Padding="6">
        <controls:LucideIcon Kind="RefreshCw" Width="18" Height="18"/>
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Entries}" Margin="12,0,12,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ActivityLogRowViewModel">
              <Border Padding="12" Margin="0,0,0,8" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding SantriNamaPanggilan}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding StatusChangeText}" FontSize="13" Opacity="0.8" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding MetaLine}" FontSize="11" Opacity="0.55" Margin="0,4,0,0"/>
                  </StackPanel>

                  <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}" FontSize="12" Opacity="0.5" VerticalAlignment="Top"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="Memuat..." IsVisible="{Binding IsLoading}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <controls:LucideIcon Kind="Clock" Width="28" Height="28" Opacity="0.3" HorizontalAlignment="Center"/>
        <TextBlock Text="Belum ada perubahan tercatat" Opacity="0.5" FontSize="13"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>