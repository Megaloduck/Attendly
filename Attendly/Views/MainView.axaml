<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Attendly.ViewModels"
             xmlns:controls="using:Attendly.Controls"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="844"
             x:Class="Attendly.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">
    <!-- Top bar: same quiet treatment as Desktop's Sidebar (Identity Statement §7) -
         canvas-toned with a hairline bottom border, not a solid accent block. -->
    <Border Grid.Row="0" Padding="14,12" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Attendly" Classes="heading" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Command="{Binding ToggleThemeCommand}" Background="Transparent" Padding="4">
            <controls:LucideIcon Kind="{Binding ThemeMode, Converter={StaticResource ThemeModeToIconKindConverter}}" Width="18" Height="18"/>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <controls:LucideIcon Kind="{Binding SyncState, Converter={StaticResource SyncStateToIconKindConverter}}"
                                  Stroke="{Binding SyncState, Converter={StaticResource SyncStateToBrushConverter}}"
                                  Width="16" Height="16"/>
            <TextBlock Text="{Binding SyncState}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>

    <!-- Bottom dock: same quiet-nav rule as the top bar and Desktop's Sidebar - a muted
         surface with a hairline separator, not the old CardBackgroundBrush/#E5E7EB pair. -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}" Padding="0,8"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
            IsVisible="{Binding IsDockVisible}">
      <ItemsControl ItemsSource="{Binding NavItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BottomNavItemViewModel">
            <Button Command="{Binding SelectCommand}" Classes="dock-item" Classes.active="{Binding IsActive}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
              <StackPanel Spacing="3" HorizontalAlignment="Center">
                <controls:LucideIcon Kind="{Binding Icon}" Width="22" Height="22"
                                      Stroke="{Binding IsActive, Converter={StaticResource ActiveToDockBrushConverter}}"/>
                <TextBlock Text="{Binding Label}" FontSize="11"
                           Foreground="{Binding IsActive, Converter={StaticResource ActiveToDockBrushConverter}}"/>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Grid>
</UserControl>
