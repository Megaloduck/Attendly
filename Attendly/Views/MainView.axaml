<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Attendly.ViewModels"
             xmlns:controls="using:Attendly.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Attendly.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,*">
<Border Padding="12" Margin="0,0,0,8" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
    <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Attendly" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Command="{Binding ToggleThemeCommand}" Background="Transparent" Padding="4">
          <controls:LucideIcon Kind="{Binding ThemeMode, Converter={StaticResource ThemeModeToIconKindConverter}}" Width="18" Height="18" Stroke="White"/>
          </Button>
          <Button Command="{Binding OpenPairingCommand}" Background="Transparent" Padding="4">
             <controls:LucideIcon Kind="QrCode" Width="18" Height="18" Stroke="White"/>
            </Button>
            <controls:LucideIcon Kind="{Binding SyncState, Converter={StaticResource SyncStateToIconKindConverter}}"
                                Stroke="{Binding SyncState, Converter={StaticResource SyncStateToBrushConverter}}"
                                Width="18" Height="18"/>
          <TextBlock Text="{Binding SyncState}" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"/>
  </Grid>
</UserControl>