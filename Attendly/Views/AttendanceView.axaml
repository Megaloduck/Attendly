<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.ViewModels"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Views.AttendanceView"
             x:DataType="vm:AttendanceViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

    <!-- Top bar: back + title + date nav -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,12,12,8">
      <Button Grid.Column="0" Command="{Binding GoBackCommand}" Background="Transparent" Padding="6">
        <controls:LucideIcon Kind="ChevronLeft" Width="20" Height="20"/>
      </Button>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
        <TextBlock Text="{Binding KelasDisplayName}" FontSize="17" FontWeight="Bold"/>
        <TextBlock Text="{Binding DateDisplay}" Opacity="0.6" FontSize="12"/>
      </StackPanel>

      <Button Grid.Column="2" Command="{Binding PreviousDayCommand}" Background="Transparent" Padding="6">
        <controls:LucideIcon Kind="ChevronLeft" Width="16" Height="16"/>
      </Button>
      <Button Grid.Column="3" Command="{Binding GoToTodayCommand}" Background="Transparent" Padding="6" IsVisible="{Binding !IsToday}">
        <controls:LucideIcon Kind="Calendar" Width="16" Height="16"/>
      </Button>
      <Button Grid.Column="4" Command="{Binding NextDayCommand}" Background="Transparent" Padding="6" IsEnabled="{Binding CanGoNext}">
        <controls:LucideIcon Kind="ChevronRight" Width="16" Height="16"/>
      </Button>
    </Grid>

    <!-- Search -->
    <TextBox Grid.Row="1" Margin="12,0,12,8" Watermark="Cari nama santri..." Text="{Binding SearchText}">
      <TextBox.InnerLeftContent>
        <controls:LucideIcon Kind="Search" Width="16" Height="16" Margin="8,0,0,0" Opacity="0.5"/>
      </TextBox.InnerLeftContent>
    </TextBox>

    <!-- Summary + bulk action -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,0,12,8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <Border Background="#DCFCE7" CornerRadius="12" Padding="8,3">
          <TextBlock Text="{Binding CountHadir, StringFormat='H {0}'}" FontSize="11" Foreground="#166534" FontWeight="SemiBold"/>
        </Border>
        <Border Background="#FEE2E2" CornerRadius="12" Padding="8,3">
          <TextBlock Text="{Binding CountAlpha, StringFormat='A {0}'}" FontSize="11" Foreground="#991B1B" FontWeight="SemiBold"/>
        </Border>
        <Border Background="#FEF3C7" CornerRadius="12" Padding="8,3">
          <TextBlock Text="{Binding CountIzin, StringFormat='I {0}'}" FontSize="11" Foreground="#92400E" FontWeight="SemiBold"/>
        </Border>
        <Border Background="#DBEAFE" CornerRadius="12" Padding="8,3">
          <TextBlock Text="{Binding CountSakit, StringFormat='S {0}'}" FontSize="11" Foreground="#1E40AF" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>

      <Button Grid.Column="1" Command="{Binding MarkAllPresentCommand}" IsVisible="{Binding HasUnmarked}"
              Classes="primary" Padding="10,6" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <controls:LucideIcon Kind="CheckCheck" Width="15" Height="15" Stroke="White"/>
          <TextBlock Text="Tandai Semua Hadir" FontSize="12" Foreground="White"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Libur banner -->
    <Border Grid.Row="3" Background="#F3F4F6" CornerRadius="8" Margin="12,0,12,8" Padding="10" IsVisible="{Binding !IsSessionDay}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:LucideIcon Kind="CalendarOff" Width="16" Height="16" Opacity="0.6"/>
        <TextBlock Text="Hari ini bukan hari sesi untuk kelas ini - santri otomatis ditandai Libur." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- List -->
    <Grid Grid.Row="4">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Rows}" Margin="12,0,12,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SantriAttendanceRowViewModel">
              <Border Padding="12" Margin="0,0,0,8" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#2563EB" VerticalAlignment="Top" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>

                  <StackPanel Grid.Column="1">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding NamaPanggilan}" FontWeight="SemiBold" FontSize="15"/>
                      <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="11" Opacity="0.6"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                      <Button Content="H" Command="{Binding MarkCommand}" CommandParameter="H"
                              Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=H}"/>
                      <Button Content="A" Command="{Binding MarkCommand}" CommandParameter="A"
                              Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=A}"/>
                      <Button Content="I" Command="{Binding MarkCommand}" CommandParameter="I"
                              Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=I}"/>
                      <Button Content="S" Command="{Binding MarkCommand}" CommandParameter="S"
                              Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=S}"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="Memuat..." IsVisible="{Binding IsLoading}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <StackPanel IsVisible="{Binding IsSearchEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <controls:LucideIcon Kind="Search" Width="28" Height="28" Opacity="0.3" HorizontalAlignment="Center"/>
        <TextBlock Text="Tidak ada santri yang cocok" Opacity="0.5" HorizontalAlignment="Center" FontSize="13"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>