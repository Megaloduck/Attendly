<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.ViewModels"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Views.AttendanceView"
             x:DataType="vm:AttendanceViewModel">
  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="12">
      <Button Grid.Column="0" Command="{Binding GoBackCommand}" Margin="0,0,8,0">
        <controls:LucideIcon Kind="ChevronLeft" Width="18" Height="18"/>
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding KelasDisplayName}" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="{Binding DateDisplay}" Opacity="0.7" FontSize="13"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Rows}" Margin="12,0,12,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SantriAttendanceRowViewModel">
            <Border Padding="12" Margin="0,0,0,8" CornerRadius="8" Background="#F3F4F6">
              <StackPanel>
                <TextBlock Text="{Binding NamaPanggilan}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="H" Command="{Binding MarkCommand}" CommandParameter="H"
                          Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=H}"/>
                  <Button Content="A" Command="{Binding MarkCommand}" CommandParameter="A"
                          Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=A}"/>
                  <Button Content="I" Command="{Binding MarkCommand}" CommandParameter="I"
                          Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=I}"/>
                  <Button Content="S" Command="{Binding MarkCommand}" CommandParameter="S"
                          Background="{Binding Status, Converter={StaticResource StatusChipBrushConverter}, ConverterParameter=S}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>