<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Attendly.ViewModels"
             xmlns:controls="using:Attendly.Controls"
             x:Class="Attendly.Views.MobilePairingView"
             x:DataType="vm:MobilePairingViewModel">
  <StackPanel Margin="20" Spacing="14" Background="{DynamicResource AppBackgroundBrush}">
    <TextBlock Text="Hubungkan ke Desktop" Classes="heading"/>

    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding IsPaired}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <controls:LucideIcon Kind="CircleCheck" Width="18" Height="18" Stroke="{DynamicResource StatusSuccessBrush}"/>
        <TextBlock Text="{Binding PairedDesktopLabel, StringFormat='Terhubung ke {0}'}" Foreground="{DynamicResource StatusSuccessBrush}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock Text="Nama Anda" FontWeight="SemiBold" FontSize="13"/>
        <TextBox Text="{Binding TeacherName}" Watermark="Contoh: Ustadzah Fatimah"/>

        <Button Command="{Binding ScanQrCommand}" Classes="primary" IsVisible="{Binding CanScanQr}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <controls:LucideIcon Kind="ScanLine" Width="16" Height="16" Stroke="White"/>
            <TextBlock Text="Pindai Kode QR" Foreground="White"/>
          </StackPanel>
        </Button>

        <TextBlock Text="Kode dari layar 'Hubungkan Perangkat Guru' di Desktop:" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0"/>
        <TextBox Text="{Binding PairingCodeInput}" Watermark="ip:port:token"/>
        <Button Content="Hubungkan" Command="{Binding ConnectCommand}" Classes="primary" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>

    <Button Content="Selesai" Command="{Binding DoneCommand}" HorizontalAlignment="Left"/>
  </StackPanel>
</UserControl>
